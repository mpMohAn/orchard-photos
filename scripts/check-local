#!/usr/bin/env python3
"""Local checks using existing dependencies. Default: print plan only."""
import argparse
import os
from pathlib import Path
import signal
import subprocess
import sys
import tempfile

ROOT = Path(__file__).resolve().parents[1]
MODULES = ('PIL', 'pillow_heif', 'numpy', 'onnxruntime', 'tokenizers', 'huggingface_hub', 'webview')
GUARDS = '''
import sys, unittest
class NoPhotos:
    def find_spec(self, fullname, path=None, target=None):
        if fullname == 'Photos':
            raise ImportError('Real PhotoKit disabled by check-local')
sys.meta_path.insert(0, NoPhotos())
def audit(event, args):
    if event in ('subprocess.Popen', 'os.system', 'os.exec', 'os.posix_spawn'):
        raise PermissionError('External commands disabled by check-local')
    if event in ('socket.connect', 'socket.bind'):
        address = args[1]
        if not isinstance(address, tuple) or address[0] not in ('127.0.0.1', '::1', 'localhost'):
            raise PermissionError('External network disabled by check-local')
sys.addaudithook(audit)
'''


def environment(base):
    env = {'PATH': os.defpath, 'HF_HUB_OFFLINE': '1', 'BROWSER': 'true',
           'PYTHONDONTWRITEBYTECODE': '1', 'PYTHONNOUSERSITE': '1',
           'HF_HUB_DISABLE_TELEMETRY': '1'}
    for key in ('HOME', 'USERPROFILE', 'XDG_DATA_HOME', 'XDG_CACHE_HOME', 'XDG_CONFIG_HOME',
                'TMPDIR', 'TMP', 'TEMP', 'HF_HOME', 'APPDATA', 'LOCALAPPDATA'):
        directory = base / key
        directory.mkdir()
        env[key] = str(directory)
    return env


def execute(command, env, timeout, cwd=ROOT):
    child = None
    try:
        child = subprocess.Popen(command, cwd=cwd, env=env, start_new_session=True)
        code = child.wait(timeout=timeout)
        return ('PASSED', 'exit 0') if code == 0 else ('FAILED', f'exit {code}')
    except subprocess.TimeoutExpired:
        return 'FAILED', f'timeout after {timeout}s'
    except OSError as error:
        return 'FAILED', str(error)
    finally:
        if child is not None:
            try:
                os.killpg(child.pid, signal.SIGKILL)
            except ProcessLookupError:
                pass
            child.wait()


def main(argv=None, root=ROOT):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('--run', action='store_true', help='execute available checks')
    args = parser.parse_args(argv)
    print('Plan: probe existing .venv/bin/python dependencies (30s), then unit suite (180s).')
    print('Isolated temporary HOME/data/cache/temp; generated fixtures; no installs or launcher.')
    print('UNVERIFIED: native desktop interactions, privacy prompts, real photo libraries,')
    print('and packaged model inference. Native test_window.py is excluded.', flush=True)
    if not args.run:
        print('Plan only; no checks executed. Use --run to execute.')
        return 0
    python = root / '.venv/bin/python'
    if not python.is_file():
        print('SKIPPED: unit suite: .venv/bin/python unavailable; dependencies not installed or probed.')
        print('Summary: 0 passed, 0 failed, 1 skipped')
        return 0
    with tempfile.TemporaryDirectory(prefix='check-local-', dir=root) as directory:
        env = environment(Path(directory))
        probe = GUARDS + '\nimport importlib.util\nmissing = [n for n in ' + repr(MODULES) + ''' if importlib.util.find_spec(n) is None]
if missing:
    print('Missing dependencies: ' + ', '.join(missing), flush=True)
sys.exit(3 if missing else 0)
'''
        status, detail = execute([str(python), '-B', '-c', probe], env, 30, root)
        if detail == 'exit 3':
            print('SKIPPED: unit suite: required dependencies unavailable; environment unchanged.')
            print('Summary: 0 passed, 0 failed, 1 skipped')
            return 0
        if status == 'FAILED':
            print(f'FAILED: dependency probe: {detail}')
            print('Summary: 0 passed, 1 failed, 1 skipped (unit suite)')
            return 1
        suite = GUARDS + '''
from pathlib import Path
suite = unittest.TestSuite()
for path in sorted(Path('tests').glob('test_*.py')):
    if path.name not in ('test_window.py', 'test_check_local.py'):
        suite.addTests(unittest.defaultTestLoader.discover('tests', pattern=path.name))
sys.exit(not unittest.TextTestRunner(verbosity=2).run(suite).wasSuccessful())
'''
        status, detail = execute([str(python), '-B', '-c', suite], env, 180, root)
        print(f'{status}: unit suite: {detail}')
        print(f'Summary: {int(status == "PASSED")} passed, {int(status == "FAILED")} failed, 1 skipped (native window tests)')
        return int(status == 'FAILED')


if __name__ == '__main__':
    def interrupted(signum, frame):
        raise KeyboardInterrupt

    signal.signal(signal.SIGTERM, interrupted)
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        print('FAILED: interrupted; owned children terminated.', file=sys.stderr)
        sys.exit(130)
